NEXT_PUBLIC_SANITY_PROJECT_ID="8wc8eouj"
NEXT_PUBLIC_SANITY_DATASET="production"

# Contact email sent to NCBI E-utilities and the Crossref polite pool.
# Do not commit a real value. Example: research@snacksmate.com
NCBI_CONTACT_EMAIL=""

# Optional. Discovery works without an NCBI API key at low volume.
# NCBI_API_KEY=""

# Newly indexed PubMed records to search. Default is 14 days.
# RESEARCH_LOOKBACK_DAYS=14

# Server-side Sanity token with read and write access.
# Required for draft duplicate checks, draft creation, and AI enrichment.
# Dry-run still reads drafts. Never prefix with NEXT_PUBLIC_.
# SANITY_WRITE_TOKEN=""

# Server-side OpenAI key for research draft enrichment.
# Used only by scripts/enrich-research.ts. Never prefix with NEXT_PUBLIC_.
# Never commit a real value.
# OPENAI_API_KEY=""

# Optional override for research enrichment.
# Default is gpt-5.6-luna, a cost-conscious model for high-volume structured extraction.
# The default lives in lib/research-enrichment/config.ts. Do not hardcode another model.
# RESEARCH_AI_MODEL="gpt-5.6-luna"
